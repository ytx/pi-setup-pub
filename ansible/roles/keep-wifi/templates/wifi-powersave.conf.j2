# Managed by Ansible - do not edit manually
#
# Disable WiFi power save.
#
# brcmfmac turns power save on by default. A dozing client only receives
# multicast at DTIM beacons and APs routinely drop what they buffered, so
# mDNS (.local) name resolution fails intermittently and latency spikes.
#
# Set as a NetworkManager global default rather than on the connection
# profile: profiles generated by netplan are rewritten on regeneration, and
# a default here still applies because those profiles do not set powersave.
#
# wifi.powersave values: 0=use default, 1=leave untouched, 2=disable, 3=enable
[connection]
wifi.powersave = 2
